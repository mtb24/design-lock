{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "src/contract-diff.test.ts",
    "packages/compiler/src/cli.ts",
    "packages/compiler/src/compile.test.ts",
    "packages/compiler/src/lifecycle.test.ts",
    "examples/react-adapters/adapters.tsx",
    "examples/react-adapters/extracted-dom.test.tsx"
  ],
  "ignorePatterns": ["dist/**", "contracts/generated/**", "contracts/baselines/**", "storybook-static/**", ".output/**"],
  "ignoreDependencies": ["@design-lock/core", "@emotion/react", "@emotion/styled", "happy-dom"],
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["src/**"] },
      { "name": "compiler", "patterns": ["packages/compiler/**"] },
      { "name": "examples", "patterns": ["examples/**"] }
    ],
    "rules": [
      { "from": "core", "allow": ["core"] },
      { "from": "compiler", "allow": ["compiler", "core"] },
      { "from": "examples", "allow": ["examples", "core"] }
    ]
  },
  "duplicates": {
    "enabled": true,
    "mode": "mild",
    "near": true,
    "minTokens": 60,
    "minLines": 6,
    "minOccurrences": 2,
    "ignore": ["**/*.test.*"],
    "skipLocal": false,
    "crossLanguage": false,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "maxCrap": 200,
    "maxUnitSize": 80,
    "ignore": ["**/*.test.*"]
  },
  "audit": {
    "gate": "new-only",
    "css": false
  }
}
