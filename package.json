{
  "name": "@design-lock/core",
  "version": "0.1.0",
  "description": "Design-system-agnostic contracts for validating AI-generated UI",
  "author": "Ken Downey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtb24/design-lock.git"
  },
  "keywords": [
    "ai",
    "design-system",
    "governance",
    "json-schema",
    "ui-validation"
  ],
  "private": false,
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:examples",
    "test:core": "vitest run",
    "test:examples": "npm run build --silent && node --import tsx --test examples/react-adapters/adapters.test.tsx",
    "audit:fallow": "npx --yes fallow@3.15.0 audit --base origin/main",
    "audit:security": "npx --yes fallow@3.15.0 security --changed-since origin/main --gate new"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
